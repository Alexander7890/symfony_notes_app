{
  "name": "app/symfony-notes",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/doctrine-bundle": "*",
    "symfony/console": "^6.4",
    "symfony/dotenv": "^6.4",
    "symfony/form": "^6.4",
    "symfony/framework-bundle": "^6.4",
    "symfony/orm-pack": "*",
    "symfony/runtime": "^6.4",
    "symfony/security-csrf": "*",
    "symfony/translation": "^6.4",
    "symfony/twig-bundle": "^6.4",
    "symfony/validator": "^6.4",
    "symfony/yaml": "^6.4"
  },
  "require-dev": {
    "symfony/debug-bundle": "^6.4",
    "symfony/var-dumper": "^6.4",
    "symfony/maker-bundle": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "6.4.*"
    }
  }
}
