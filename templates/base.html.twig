<!DOCTYPE html>
<html lang="{{ app.request.get('lang', 'uk') }}">
<head>
  <meta charset="UTF-8">
  <title>{% block title %}Symfony Notes{% endblock %}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body {
      max-width: 1000px;
      margin: 0 auto;
      padding: 16px;
      font-family: system-ui, sans-serif;
      background: #ffffff;
      color: #222222;
    }
    .dark body {
      background: #1e1e1e;
      color: #f5f5f5;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 8px;
      border-bottom: 1px solid rgba(0,0,0,0.06);
    }
    th {
      text-align: left;
    }
    .btn {
      padding: 4px 8px;
      cursor: pointer;
    }
    .btn-danger {
      background: #c0392b;
      color: #fff;
      border: none;
    }
    .btn-primary {
      background: #3498db;
      color: #fff;
      border: none;
    }
    .btn-secondary {
      background: #7f8c8d;
      color: #fff;
      border: none;
    }
    input[type="text"], textarea, select {
      width: 100%;
      padding: 4px 6px;
      box-sizing: border-box;
    }
    .error {
      color: crimson;
      font-size: 12px;
    }
    .pagination {
      margin-top: 12px;
      display: flex;
      gap: 8px;
      align-items: center;
    }
  </style>
  {% block styles %}{% endblock %}
</head>
<body>
  {% block body %}{% endblock %}

  <script>
    (function() {
      const LS_THEME_KEY = 'notes:theme';
      function applyTheme(theme) {
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }
      const saved = localStorage.getItem(LS_THEME_KEY) || 'light';
      applyTheme(saved);
      window.toggleTheme = function() {
        const current = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        localStorage.setItem(LS_THEME_KEY, next);
        applyTheme(next);
      };
    })();
  </script>

  {% block javascripts %}{% endblock %}
</body>
</html>
