{% extends 'base.html.twig' %}

{% block title %}{{ t.editModal }}{% endblock %}

{% block body %}
  <h1>{{ t.editModal }}</h1>

  <form method="post">
    <div style="margin-bottom:8px;">
      <label>{{ t.noteTitle }}</label>
      <input type="text" name="title" value="{{ note.title }}"/>
      {% if errors.title is defined %}
        <div class="error">{{ errors.title }}</div>
      {% endif %}
    </div>
    <div style="margin-bottom:8px;">
      <label>{{ t.noteText }}</label>
      <textarea name="text" rows="6">{{ note.text }}</textarea>
    </div>
    <button type="submit" class="btn btn-primary">{{ lang == 'uk' ? 'Зберегти' : 'Save' }}</button>
    <a href="{{ path('note_index', {lang: lang}) }}" class="btn btn-secondary" style="text-decoration:none;">{{ lang == 'uk' ? 'Назад' : 'Back' }}</a>
  </form>
{% endblock %}
