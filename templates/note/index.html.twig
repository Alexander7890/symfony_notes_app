{% extends 'base.html.twig' %}

{% block title %}{{ t.title }}{% endblock %}

{% block body %}
  <h1>{{ t.title }}</h1>

  <form method="get" action="{{ path('note_index') }}" style="display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap;">
    <input
      type="text"
      name="q"
      placeholder="{{ t.searchPlaceholder }}"
      value="{{ search }}"
    />
    <input type="hidden" name="lang" value="{{ lang }}"/>
    <button type="submit" class="btn btn-secondary">{{ t.find }}</button>
    <a href="{{ path('note_index', {lang: lang}) }}" class="btn btn-secondary" style="text-decoration:none; display:inline-block; padding:4px 8px;">{{ t.clear }}</a>

    <div style="margin-left:auto; display:flex; gap:8px; align-items:center;">
      <button type="button" class="btn" onclick="toggleTheme()">
        {% if app.request.cookies.get('theme') == 'dark' %}
          {{ lang == 'uk' ? '🌙 Темна' : '🌙 Dark' }}
        {% else %}
          {{ lang == 'uk' ? '☀️ Світла' : '☀️ Light' }}
        {% endif %}
      </button>

      <select name="lang" onchange="this.form.submit()">
        <option value="uk" {% if lang == 'uk' %}selected{% endif %}>🇺🇦 Укр</option>
        <option value="en" {% if lang == 'en' %}selected{% endif %}>🇬🇧 Eng</option>
      </select>

      <label style="font-size:13px;">{{ t.sortBy }}</label>
      <select name="sort" onchange="this.form.submit()">
        <option value="createdAt" {% if sort == 'createdAt' %}selected{% endif %}>{{ t.date }}</option>
        <option value="title" {% if sort == 'title' %}selected{% endif %}>{{ t.noteTitle }}</option>
      </select>
      <select name="dir" onchange="this.form.submit()">
        <option value="desc" {% if dir == 'desc' %}selected{% endif %}>↓</option>
        <option value="asc" {% if dir == 'asc' %}selected{% endif %}>↑</option>
      </select>
    </div>
  </form>

  <form method="post" action="{{ path('note_index', {lang: lang, q: search, sort: sort, dir: dir, page: page, perPage: perPage}) }}" style="display:grid; gap:8px; margin-bottom:16px;">
    <input type="hidden" name="lang" value="{{ lang }}"/>
    <input type="hidden" name="create" value="1"/>
    <div>
      <input type="text" name="title" placeholder="{{ t.noteTitle }} *" value="{{ form_title }}"/>
      {% if errors.title is defined %}
        <div class="error">{{ errors.title }}</div>
      {% endif %}
    </div>
    <textarea name="text" rows="6" placeholder="{{ t.noteText }}">{{ form_text }}</textarea>
    <button type="submit" class="btn btn-primary">{{ t.addNote }}</button>
  </form>

  {% if notes|length > 0 %}
    <form method="post" action="{{ path('note_mass_delete', {lang: lang}) }}">
      <table>
        <thead>
          <tr>
            <th></th>
            <th>{{ t.noteTitle }}</th>
            <th>{{ t.noteText }}</th>
            <th>{{ t.date }}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
        {% for note in notes %}
          <tr>
            <td>
              <input type="checkbox" name="ids[]" value="{{ note.id }}"/>
            </td>
            <td><strong>{{ note.title }}</strong></td>
            <td>
              {% set text = note.text ?? '—' %}
              {% if text|length > 180 %}
                {{ text|slice(0, 180) ~ '…' }}
              {% else %}
                {{ text }}
              {% endif %}
            </td>
            <td>{{ note.createdAt|date('Y-m-d H:i') }}</td>
            <td>
              <a href="{{ path('note_edit', {id: note.id, lang: lang}) }}" class="btn btn-secondary" style="text-decoration:none;">{{ t.edit }}</a>
              <form method="post" action="{{ path('note_delete', {id: note.id, lang: lang}) }}" style="display:inline;">
                <button type="submit" class="btn btn-danger">{{ t.delete }}</button>
              </form>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>

      <div style="margin-top:8px;">
        <button type="submit" class="btn btn-danger">{{ t.massDelete }}</button>
      </div>
    </form>
  {% else %}
    <p>{{ t.noteNotFound }}</p>
  {% endif %}

  <div class="pagination">
    {% set maxPage = (total / perPage)|round(0, 'ceil')|default(1) %}
    <span>
      {{ lang == 'uk' ? 'Сторінка' : 'Page' }} {{ page }} / {{ maxPage }}
    </span>
    {% if page > 1 %}
      <a href="{{ path('note_index', {lang: lang, q: search, sort: sort, dir: dir, page: page-1, perPage: perPage}) }}" class="btn btn-secondary" style="text-decoration:none;">«</a>
    {% endif %}
    {% if page < maxPage %}
      <a href="{{ path('note_index', {lang: lang, q: search, sort: sort, dir: dir, page: page+1, perPage: perPage}) }}" class="btn btn-secondary" style="text-decoration:none;">»</a>
    {% endif %}
    <form method="get" action="{{ path('note_index') }}" style="margin-left:16px;">
      <input type="hidden" name="lang" value="{{ lang }}"/>
      <input type="hidden" name="q" value="{{ search }}"/>
      <input type="hidden" name="sort" value="{{ sort }}"/>
      <input type="hidden" name="dir" value="{{ dir }}"/>
      <label>
        {{ lang == 'uk' ? 'На сторінці:' : 'Per page:' }}
        <select name="perPage" onchange="this.form.submit()">
          {% for size in [3,6,10,20] %}
            <option value="{{ size }}" {% if perPage == size %}selected{% endif %}>{{ size }}</option>
          {% endfor %}
        </select>
      </label>
    </form>
  </div>
{% endblock %}
